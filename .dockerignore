# ==============================================================================
# Impera CAM — .dockerignore
# Avoid baking PII, statement files, virtual environments, or caches into images
# ==============================================================================

# Personal Identifiable Information & Financial Statements
Bank/
Croped Bank PDF's/
data/account_registry.json
data/uploads/*
!data/uploads/.gitkeep
output/*
!output/.gitkeep
scratch/

*.pdf
*.xlsx
*.xls
*.csv

# Secrets & Local Configuration
.env
.env.*
!.env.example
*.pem
*.key

# Git & Agentic metadata
.git/
.agents/
.claude/
.cursor/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/

# OCR & Cache
.paddleocr/
.cache/

# Testing & Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
