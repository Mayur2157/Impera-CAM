# Optional settings. Local development needs none of them:
#   python main.py   → SQLite file data/impera_cam.db, jobs on threads in the API process.
# The app reads the OS environment only (it does not load a .env file). Set what
# you need in your shell first, e.g. in cmd:  set BSX_LOCAL_WORKERS=4
# or in PowerShell:  $env:BSX_LOCAL_WORKERS = "4"
# Never commit real secrets.

# dev allows the placeholders below; prod refuses to start with them
BSX_ENV=dev

# Database: leave unset for the local SQLite file, or point at a MySQL server
# BSX_MYSQL_URL=mysql+pymysql://impera:CHANGE_ME@127.0.0.1:3306/impera_cam

# Jobs: "local" (threads in the API process, no Redis) or "celery" (Redis + worker processes)
BSX_QUEUE=local
# digital statements processed at once in local mode (scanned ones use one GPU thread)
BSX_LOCAL_WORKERS=2
# celery mode only:
# BSX_REDIS_URL=redis://127.0.0.1:6379/0

# Auth. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BSX_JWT_SECRET=CHANGE_ME_USE_A_RANDOM_64_CHAR_HEX_STRING
BSX_JWT_EXPIRE_HOURS=24

# CORS: only needed when the frontend is served from another origin
BSX_ALLOWED_ORIGINS=http://localhost:8000

# Storage, relative to the project root
BSX_UPLOAD_DIR=data/uploads
BSX_OUTPUT_DIR=output
BSX_RETENTION_SECONDS=21600

# OCR for scanned statements. Set BSX_OCR_DEVICE=cpu if there is no GPU.
BSX_OCR_BACKEND=paddle
BSX_OCR_DEVICE=gpu
BSX_OCR_GPU_ID=0
