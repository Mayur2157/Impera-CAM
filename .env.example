# Copy this file to .env and fill in real values before starting the server.
# .env is git-ignored; never commit real secrets.

# ── MySQL ────────────────────────────────────────────────────────────────────
BSX_MYSQL_URL=mysql+pymysql://root:CHANGE_ME@localhost/impera_cam
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BSX_JWT_SECRET=CHANGE_ME_USE_A_RANDOM_64_CHAR_HEX_STRING
BSX_JWT_EXPIRE_HOURS=24

# ── CORS — list the exact origin(s) your frontend is served from ─────────────
# Development:
BSX_ALLOWED_ORIGINS=http://localhost:8000
# Production (example):
# BSX_ALLOWED_ORIGINS=https://app.imperacam.com

# ── Storage ──────────────────────────────────────────────────────────────────
BSX_UPLOAD_DIR=data/uploads
BSX_OUTPUT_DIR=output
BSX_MAX_UPLOAD_MB=40
BSX_MAX_FILES=25

# ── Processing ───────────────────────────────────────────────────────────────
BSX_WORKERS=4
BSX_RETENTION_SECONDS=21600

# ── OCR ──────────────────────────────────────────────────────────────────────
BSX_OCR_BACKEND=paddle
BSX_OCR_DEVICE=gpu          # set to cpu if no GPU
BSX_OCR_GPU_ID=0
