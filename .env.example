# Copy this file to .env and fill in real values before starting the stack.
# .env is git-ignored; never commit real secrets.
# docker compose reads .env automatically. A native process (python main.py,
# a native OCR worker) reads only the OS environment — set these there too.
# Comments sit on their own lines: an inline "# ..." would become part of the value.

# dev allows the placeholders below; prod refuses to start with them
BSX_ENV=dev

# MySQL (docker compose creates the app user; the API never connects as root)
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_USER=impera
MYSQL_PASSWORD=CHANGE_ME
# host port of the compose MySQL; for a native process on this machine:
BSX_DB_HOST_PORT=3307
BSX_MYSQL_URL=mysql+pymysql://impera:CHANGE_ME@127.0.0.1:3307/impera_cam

# Redis: the queue between the API and the workers (native processes)
BSX_REDIS_URL=redis://127.0.0.1:6379/0

# Auth. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BSX_JWT_SECRET=CHANGE_ME_USE_A_RANDOM_64_CHAR_HEX_STRING
BSX_JWT_EXPIRE_HOURS=24

# CORS: the exact origin(s) the frontend is served from
BSX_ALLOWED_ORIGINS=http://localhost:8000

# Storage, relative to the project root for native processes
BSX_UPLOAD_DIR=data/uploads
BSX_OUTPUT_DIR=output
BSX_MAX_UPLOAD_MB=40
BSX_MAX_FILES=25
BSX_RETENTION_SECONDS=21600

# Capacity: API processes, CPU worker processes, active files per tenant
BSX_API_WORKERS=4
BSX_CPU_WORKERS=8
BSX_TENANT_MAX_ACTIVE_FILES=50

# OCR, read by the GPU worker. Set BSX_OCR_DEVICE=cpu if there is no GPU.
BSX_OCR_BACKEND=paddle
BSX_OCR_DEVICE=gpu
BSX_OCR_GPU_ID=0
